[["wait", 150], ["eval", "(()=>{const r=__shellReview,m=r.motion,$=id=>document.getElementById(id);m.reset();const camera=r.camera.position.toArray();$('explode').click();let n=performance.now();const tick=c=>{for(let i=0;i<c;i++)m.update(n+=50);};tick(12);m.state.paused=true;const frozen=JSON.stringify(r.explosion.assemblies.map(a=>a.group.position.toArray()));tick(10);if(frozen!==JSON.stringify(r.explosion.assemblies.map(a=>a.group.position.toArray())))throw Error('pause');m.state.paused=false;tick(1);$('explode').click();tick(70);if(m.state.spread!==0)throw Error('reverse');$('explode').click();tick(70);const p=r.explosion.assemblies.map(a=>a.group.position.toArray());r.setTheme('dark');if(JSON.stringify(p)!==JSON.stringify(r.explosion.assemblies.map(a=>a.group.position.toArray())))throw Error('theme pose');if(camera.some((v,i)=>Math.abs(v-r.camera.position.toArray()[i])>1e-6))throw Error('camera');if(!$('release').disabled||!$('reload').disabled)throw Error('interlock');for(let i=0;i<=100;i++){r.explosion.apply(i/100);if(r.explosion.assemblies.some(a=>!a.group.position.toArray().every(Number.isFinite)))throw Error('path');}return {groups:r.explosion.assemblies.length,pause:true,reversal:true,theme:true,camera:true,finitePoses:101};})()"], ["click", "#reset"], ["wait", 150], ["shot", "/tmp/sr6-explode-dark-final.png", "main"], ["click", "#theme"], ["shot", "/tmp/sr6-explode-light-final.png", "main"], ["click", "#motionReset"], ["eval", "(()=>{if(__shellReview.explosion.assemblies.some(a=>!a.group.visible||a.group.position.length()>.00001))throw Error('reset');return 'reset complete'})()"]]